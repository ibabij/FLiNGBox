{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FLiNG Box",
  "version": "1.0.2",
  "identifier": "com.flingbox.desktop",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FLiNG Box",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "shadow": true,
        "backgroundColor": "#0c0e14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
