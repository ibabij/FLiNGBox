{
  "name": "fling-box",
  "productName": "FLiNG Box",
  "version": "1.0.0",
  "description": "FLiNG Box - 现代化风灵月影修改器盒子",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "fling-trainer",
    "game-trainer",
    "electron",
    "desktop-app"
  ],
  "author": "JIBI",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jibi.flingbox",
    "productName": "FLiNG Box",
    "copyright": "Copyright © 2024-2026 JIBI",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "assets/**/*",
      "!assets/screenshots/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powertest,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin"
    ],
    "artifactName": "FLiNG-Box-v${version}-Portable.${ext}",
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
